# Supabase project URL and public API key.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR-SUPABASE-PUBLISHABLE-KEY

# Auth user UUID; must match app_config.owner_user_id in setup.md.
OWNER_USER_ID=YOUR-OWNER-AUTH-USER-UUID

# Use your production origin when deploying (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only key required for profile photo uploads and removal. Never expose publicly.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVER-ONLY-SERVICE-ROLE-KEY
